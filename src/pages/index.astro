---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ArticleCard from '../components/ArticleCard.astro';
import RecentItem from '../components/RecentItem.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
import { getCollection } from 'astro:content';

const articulos = await getCollection('articulos');
const all = articulos
  .sort((a: typeof articulos[number], b: typeof articulos[number]) => b.data.date.valueOf() - a.data.date.valueOf());

const featured = all.filter((a: typeof articulos[number]) => a.data.featured).slice(0, 3);
const recent = all.slice(0, 6);

const categorias = [
  { title: 'Derecho Penal Corporativo', desc: 'Análisis de responsabilidad penal empresarial, compliance penal y estrategias de defensa.', icon: 'shield' },
  { title: 'Compliance y Ley 30424', desc: 'Implementación de programas de prevención y gestión de riesgos legales empresariales.', icon: 'doc' },
  { title: 'Ciberdelincuencia y Datos', desc: 'Delitos informáticos, protección de datos personales y ciberseguridad jurídica.', icon: 'monitor' },
  { title: 'IA y Nuevas Tecnologías', desc: 'Regulación de inteligencia artificial, blockchain y tecnologías emergentes en el derecho.', icon: 'layers' },
];
---
<BaseLayout
  title="Bases sólidas para el derecho penal, corporativo y digital"
  description="Análisis jurídico especializado en derecho penal corporativo, compliance y nuevos desafíos tecnológicos para empresas en Perú."
>
  <Header />

  <section class="fj-hero">
    <div class="fj-hero-inner">
      <h1>Bases sólidas para el <em>derecho penal, corporativo</em> y digital</h1>
      <p class="fj-hero-subtitle">
        Análisis jurídico especializado en derecho penal corporativo, compliance y nuevos desafíos tecnológicos para empresas en Perú
      </p>
      <div class="fj-hero-actions">
        <a href="/articulos" class="fj-btn fj-btn-gold">Leer último artículo</a>
        <a href="#newsletter" class="fj-btn fj-btn-outline">Suscríbete a la Newsletter</a>
      </div>
    </div>
  </section>

  <section class="fj-section">
    <div class="fj-section-inner">
      <div class="fj-section-header">
        <h2>Artículos destacados</h2>
        <p>Los análisis más relevantes de nuestra revista jurídica especializada</p>
        <div class="fj-gold-line"></div>
      </div>
      <div class="fj-articles-grid">
        {featured.map((a: typeof featured[number]) => <ArticleCard articulo={a} />)}
      </div>
    </div>
  </section>

  <section class="fj-section" style="background: var(--fj-gray-100);">
    <div class="fj-section-inner">
      <div class="fj-section-header">
        <h2>Categorías principales</h2>
        <p>Explora nuestros temas de especialización</p>
        <div class="fj-gold-line"></div>
      </div>
      <div class="fj-categories-grid">
        {categorias.map(c => (
          <a href={`/categorias/${c.title.includes('Penal') ? 'Derecho Penal' : c.title.includes('Compliance') ? 'Compliance' : c.title.includes('Ciber') ? 'Ciberseguridad' : 'IA & Tech'}`} class="fj-category-card">
            <div class="fj-category-icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
              </svg>
            </div>
            <h3>{c.title}</h3>
            <p>{c.desc}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="fj-section fj-about">
    <div class="fj-section-inner">
      <div class="fj-about-grid">
        <div class="fj-about-img" style={`background-image: url('${import.meta.env.BASE_URL}/img/logo-completo.png');`}></div>
        <div class="fj-about-text">
          <h2>Sobre la revista</h2>
          <p>Fundamento Jurídico nace como un espacio de análisis riguroso para profesionales y empresas que buscan comprender y prevenir los riesgos legales en la era digital...</p>
          <a href="/sobre" class="fj-btn fj-btn-dark">Conoce más sobre nosotros</a>
        </div>
      </div>
    </div>
  </section>

  <section class="fj-newsletter" id="newsletter">
    <NewsletterForm />
  </section>

  <section class="fj-section">
    <div class="fj-section-inner">
      <div class="fj-section-header">
        <h2>Artículos recientes</h2>
        <p>Lo último de nuestro equipo editorial</p>
        <div class="fj-gold-line"></div>
      </div>
      <div class="fj-recent-list">
        {recent.map((a: typeof recent[number]) => <RecentItem articulo={a} />)}
      </div>
      <div class="fj-view-all">
        <a href="/articulos" class="fj-btn fj-btn-dark">Ver todos los artículos</a>
      </div>
    </div>
  </section>

  <Footer />
</BaseLayout>