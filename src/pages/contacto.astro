---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---
<BaseLayout 
  title="Contacto" 
  description="Ponte en contacto con el equipo editorial de Fundamento Jurídico. Estamos abiertos a colaboraciones, consultas y sugerencias."
>
  <Header />

  <section class="fj-legal-page">
    <div class="fj-section-inner">
      <div class="fj-section-header">
        <h2>Ponte en Contacto</h2>
        <p>¿Tienes alguna consulta, propuesta de colaboración o quieres publicar un artículo con nosotros?</p>
        <div class="fj-gold-line"></div>
      </div>

      <div class="fj-contact-grid">
        
        <!-- Información de Contacto -->
        <div class="fj-contact-info">
          <h3>Información de Contacto</h3>
          <p>Nuestro equipo editorial está listo para escucharte. Escríbenos y te responderemos a la brevedad posible.</p>

          <div class="fj-contact-item">
            <div class="fj-contact-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
            </div>
            <div>
              <strong>Correo Electrónico</strong>
              <a href="mailto:hola@fundamentojuridico.com">hola@fundamentojuridico.com</a>
            </div>
          </div>

          <div class="fj-contact-item">
            <div class="fj-contact-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
            </div>
            <div>
              <strong>Ubicación</strong>
              <span>Lima, Perú</span>
            </div>
          </div>

          <div class="fj-contact-item">
            <div class="fj-contact-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
            </div>
            <div>
              <strong>Horario de Atención</strong>
              <span>Lunes a Viernes, 9:00 - 18:00</span>
            </div>
          </div>
        </div>

        <!-- Formulario de Contacto -->
        <form id="form-contacto" class="fj-contact-form" action="https://formspree.io/f/mvkayldd" method="POST">
        <input type="hidden" name="_next" value="https://http://localhost:4321//gracias" />
          <div class="fj-form-group">
            <label for="name">Nombre Completo *</label>
            <input type="text" id="name" name="name" required placeholder="Tu nombre" autocomplete="name" />
          </div>

          <div class="fj-form-group">
            <label for="email">Correo Electrónico *</label>
            <input type="email" id="email" name="email" required placeholder="tu@correo.com" autocomplete="email" />
          </div>

          <div class="fj-form-group">
            <label for="subject">Asunto *</label>
            <input type="text" id="subject" name="subject" required placeholder="Motivo de tu mensaje" />
          </div>

          <div class="fj-form-group">
            <label for="message">Mensaje *</label>
            <textarea id="message" name="message" required placeholder="Escribe tu mensaje aquí..."></textarea>
          </div>

          <div class="fj-consent" style="color: var(--fj-gray-500);">
            <input type="checkbox" name="consent" required />
            <span>Acepto la <a href="/privacidad" style="color: var(--fj-gold); text-decoration: underline;">política de privacidad</a> (Ley 29733)</span>
          </div>

          <button type="submit" class="fj-btn fj-btn-gold" style="width: 100%;">Enviar Mensaje</button>
        </form>

      </div>
    </div>
  </section>

  <Footer />
  <script>
  const form = document.getElementById('form-contacto') as HTMLFormElement | null;
  if (form) {
    form.addEventListener('submit', async (event) => {
      event.preventDefault(); // Evita que el navegador vaya a Formspree

      const data = new FormData(form);
      const response = await fetch(form.action, {
        method: 'POST',
        body: data,
        headers: { 'Accept': 'application/json' }
      });

      if (response.ok) {
        // Si el envío es exitoso, redirige a tu página de gracias
        window.location.href = 'https://fundamentojuridico.com/gracias';
      } else {
        alert('Hubo un error al enviar el mensaje. Por favor, inténtalo de nuevo.');
      }
    });
  }
</script>
</BaseLayout>