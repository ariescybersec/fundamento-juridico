---
const current = Astro.url.pathname;

// Creamos la nueva estructura de navegación
const navItems = [
  { href: '/', label: 'Inicio' },
  { href: '/articulos', label: 'Artículos' },
  { href: '/sobre', label: 'Sobre Nosotros' },
  { href: '/#newsletter', label: 'Newsletter' },
  { href: '/contacto', label: 'Contacto' },
];

// Aquí van todas las ramas del derecho que quieres abarcar
const categorias = [
  { href: '/categorias/Derecho Penal', label: 'Derecho Penal' },
  { href: '/categorias/Compliance', label: 'Compliance' },
  { href: '/categorias/Ciberseguridad', label: 'Ciberseguridad' },
  { href: '/categorias/IA & Tech', label: 'IA & Tech' },
  { href: '/categorias/Derecho Civil', label: 'Derecho Civil' },
  { href: '/categorias/Derecho Laboral', label: 'Derecho Laboral' },
  { href: '/categorias/Derecho Administrativo', label: 'Derecho Administrativo' },
  { href: '/categorias/Derecho Tributario', label: 'Derecho Tributario' },
];
---
<header class="fj-header">
  <div class="fj-header-inner">
    <a href="/" class="fj-logo">
      <img src="/img/logo-oscuro.png" alt="Fundamento Jurídico" class="fj-logo-mark" />
      Fundamento Jurídico
    </a>

        <nav class="fj-nav" aria-label="Navegación principal">
      {navItems.slice(0, 2).map(item => ( // Inicio y Artículos
        <a href={item.href} class={current === item.href ? 'active' : ''}>{item.label}</a>
      ))}
      
      <!-- Menú Desplegable -->
      <div class="fj-dropdown">
        <a href="#" class="fj-dropdown-toggle">
          Campos <span class="fj-arrow">▾</span>
        </a>
        <ul class="fj-dropdown-menu">
          {categorias.map(cat => (
            <li><a href={cat.href}>{cat.label}</a></li>
          ))}
        </ul>
      </div>

      {navItems.slice(2).map(item => ( // El resto de enlaces
        <a href={item.href} class={current === item.href ? 'active' : ''}>{item.label}</a>
      ))}
      <a href="/#newsletter" class="fj-btn fj-btn-gold">Suscríbete</a>
    </nav>

    <button
      class="fj-mobile-toggle"
      aria-label="Abrir menú"
      aria-expanded="false"
      aria-controls="mobile-nav"
      id="menu-toggle"
    >
      <span></span><span></span><span></span>
    </button>
  </div>

  <nav class="fj-mobile-nav" id="mobile-nav" aria-label="Menú móvil">
    {navItems.map(item => (
      <a href={item.href}>{item.label}</a>
    ))}
    <a href="/#newsletter" class="fj-btn fj-btn-gold">Suscríbete Gratis</a>
  </nav>
</header>

<script>
  const toggle = document.getElementById('menu-toggle')!;
  const nav = document.getElementById('mobile-nav')!;
  toggle.addEventListener('click', () => {
    const open = nav.classList.toggle('active');
    toggle.setAttribute('aria-expanded', String(open));
    toggle.classList.toggle('active', open);
  });
  nav.querySelectorAll('a').forEach(a =>
    a.addEventListener('click', () => {
      nav.classList.remove('active');
      toggle.classList.remove('active');
      toggle.setAttribute('aria-expanded', 'false');
    })
  );
  window.addEventListener('scroll', () => {
    const header = document.querySelector('.fj-header') as HTMLElement;
    header.style.boxShadow = window.scrollY > 10 ? '0 2px 12px rgba(10,25,47,0.08)' : 'none';
  });
</script>