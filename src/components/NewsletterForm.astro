---
interface Props { compact?: boolean }
const { compact = false } = Astro.props;
---
<div class="fj-newsletter-inner">
  <h2>Recibe análisis jurídico de alto nivel cada semana</h2>
  <p>Únete a profesionales del derecho corporativo que confían en Fundamento Jurídico</p>

  <form
    class="fj-newsletter-form"
    action="https://script.google.com/macros/s/AKfycbwXVCc6m6Ml1fKD1mcW6ITPY2CAsUYfKz_-dzcIzw7diMl1Scq1_Wy4iG04dAEMnhXF/exec"
    method="POST"
    data-newsletter
  >
    <input type="text" name="nombre" placeholder="Nombres" required />
    <input type="text" name="apellidos" placeholder="Apellidos" required />
    <input type="email" name="email" placeholder="Correo electrónico" required />
    <input type="tel" name="telefono" placeholder="Teléfono" required />

    <label class="fj-consent">
      <input type="checkbox" name="consent" required />
      <span>Acepto la <a href="/privacidad">política de privacidad</a> (Ley 29733)</span>
    </label>

    <button type="submit" class="fj-btn fj-btn-gold">Suscribirme</button>
    <p class="fj-newsletter-msg" role="status" aria-live="polite"></p>
  </form>

  <small>Sin spam. Cancela cuando quieras.</small>
</div>

<script>
  document.querySelectorAll<HTMLFormElement>('[data-newsletter]').forEach((form) => {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const btn = form.querySelector('button')!;
      const msg = form.querySelector('.fj-newsletter-msg') as HTMLElement;
      const originalText = btn.textContent;
      btn.textContent = 'Enviando…';
      btn.disabled = true;
      msg.textContent = '';
      msg.className = 'fj-newsletter-msg';

      try {
        const res = await fetch(form.action, { method: 'POST', body: new FormData(form) });
        if (!res.ok) throw new Error('HTTP ' + res.status);
        msg.textContent = '✓ ¡Gracias! Te has suscrito correctamente.';
        msg.classList.add('success');
        form.reset();
      } catch (err) {
        msg.textContent = '⚠ Hubo un problema. Inténtalo de nuevo en unos minutos.';
        msg.classList.add('error');
      } finally {
        btn.textContent = originalText;
        btn.disabled = false;
      }
    });
  });
</script>